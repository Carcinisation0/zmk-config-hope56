#include "zmk-nodefree-config/keypos_def/keypos_56keys.h"
#include "zmk-nodefree-config/helper.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
 
#define ___ &trans
 
#define BASE  0
#define NUM   1
#define GAME  2
#define GPLUS 3
#define NAV   4
#define FUN   5
 
#define KEYS_L LN0 LN1 LN2 LN3 LN4   LT0 LT1 LT2 LT3 LT4 LT5   LM0 LM1 LM2 LM3 LM4 LM5   LB0 LB1 LB2 LB3 LB4  // left hand
#define KEYS_R RN0 RN1 RN2 RN3 RN4   RT0 RT1 RT2 RT3 RT4 RT5   RM0 RM1 RM2 RM3 RM4 RM5   RB0 RB1 RB2 RB3 RB4  // right hand
#define THUMBS LH3 LH2 LH1 LH0   RH0 RH1 RH2 RH3                                                              // thumbs
 
#include "combos.dtsi"
 
// hyper key / meh z mapy totem
#define HYP F18
#define MEH F19
 
#define QUICK_TAP_MS 175
 
// sticky key aka 'one-shot mods'
&sk {
    release-after-ms = <2000>;
    quick-release;
};
 
// default layer-tap config
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
};
 
#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
    ZMK_BEHAVIOR(NAME, hold_tap, \
        flavor = "balanced"; \
        tapping-term-ms = <280>; \
        quick-tap-ms = <QUICK_TAP_MS>; \
        require-prior-idle-ms = <150>; \
        bindings = <HOLD>, <TAP>; \
        hold-trigger-key-positions = <TRIGGER_POS>; \
        hold-trigger-on-release; \
    )
 
MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS)  // lewostronne HRMs
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS)  // prawostronne HRMs
 
/ {
    keymap {
        compatible = "zmk,keymap";
 
        BASE {
            display-name = "base";
            bindings = <
              &kp N1        &kp N2        &kp N3         &kp N4         &kp N5             &kp N6           &kp N7           &kp N8           &kp N9        &kp N0       
___           &kp W         &kp L         &kp Y          &kp P          &kp B              &kp Z            &kp F            &kp O            &kp U         &kp SEMI     ___
&kp ENTER     &hml LGUI C   &hml LALT R   &hml LSHFT S   &hml LCTRL T   &kp G              &kp M            &hmr RCTRL N     &hmr RSHFT E     &hmr LALT I   &hmr RGUI A  &kp ENTER
              &kp K         &kp J         &hml MEH V     &hml HYP D     &kp Q              &kp X            &hmr HYP H       &hmr MEH COMMA   &kp PERIOD    &kp SLASH    
                            &mo FUN       &mo NAV        &lt NUM SPACE  ___                ___              &mt RSHFT SPACE  &kp RALT         &mo FUN    
            >;
        };
 
        NUM {
            display-name = "num";
            bindings = <
              &kp F1        &kp F2        &kp F3         &kp F4         &kp F5             &kp F6            &kp F7               &kp F8                &kp F9        &kp F10       
&kp F12       &kp N6        &kp N7        &kp N8         &kp N9         &kp N0             &kp LG(MINUS)     &kp LEFT_BRACKET     &kp RIGHT_BRACKET     &kp BACKSLASH &kp PIPE     ___
&kp ENTER     &kp N1        &kp N2        &kp N3         &kp N4         &kp N5             &kp LG(LS(MINUS)) &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp UNDER     &kp EQUAL    &kp ENTER
              &kp SLASH     &kp KP_MULTIPLY &kp MINUS    &kp PLUS       &kp F11            &none             &kp LEFT_BRACE       &kp RIGHT_BRACE       &kp GRAVE     &kp TILDE    
                                          ___            ___            ___                ___              ___              ___              ___           ___       
            >;
        };
 
        GAME {
            display-name = "game";
            bindings = <
              &kp N1        &kp N2        &kp N3         &kp N4         &kp N5             ___              ___              ___              ___           ___       
___           &kp TAB       &kp Q         &kp W          &kp E          &kp R              &kp TILDE        &none            &kp UP           &none         &none        &to BASE
&kp N2        &kp LSHIFT    &kp A         &kp S          &kp D          &sl GPLUS          &kp LG(G)        &kp LEFT         &kp DOWN         &kp RIGHT     &kp ENTER    &to BASE
              &kp LCTRL     &kp Z         &kp X          &kp C          &kp F              &none            &kp PAGE_UP      &none            &kp PAGE_DOWN &none        
                                          &kp LALT       &mo NAV        &kp SPACE          &kp LALT         ___              ___              ___           ___    
            >;
        };
 
        GPLUS {
            display-name = "gplus";
            bindings = <
              &kp F1        &kp F2        &kp F3         &kp F4         &kp F5             ___              ___              ___              ___           ___       
___           &kp F5        &kp N1        &kp N2         &kp N3         &kp F9             &none            &none            &none            &none         &none        ___
&none         &kp LALT      &kp SLASH     &kp K          &kp Y          &kp V              &kp LG(G)        &none            &none            &none         &none        &none
              &none         &kp L         &kp I          &kp T          &kp F8             &kp N6           &none            &none            &none         &none        
                            &kp J         &kp G          &kp M          &kp LALT           &none            &none            &none            &none    
            >;
        };
 
        NAV {
            display-name = "nav";
            bindings = <
       ___           ___           ___            ___            ___                ___              ___              ___              ___           ___       
___           &kp ESC              &kp DEL               &kp UP            &kp BACKSPACE     &kp LC(BACKSPACE)        &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)   &to GAME
&kp LEFT_GUI  &kp ENTER            &kp LEFT              &kp DOWN          &kp RIGHT         &kp PG_UP                &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)   &to GAME
              &kp LEFT_CONTROL     &mt LEFT_ALT LG(TAB)  &kp C_PLAY_PAUSE  &kp TAB           &kp PAGE_DOWN            &none       &none       &none       &none       &none        
                                          ___            ___            ___                ___              ___              &kp SPACE        ___           ___       
            >;
        };
 
        FUN {
            display-name = "fun";
            bindings = <
       ___           ___           ___            ___            ___                ___              ___              ___              ___           ___       
___           &kp LS(L)     &kp H         &kp A          &kp I          &kp E              &none            &kp F7           &kp F8           &kp F9        &kp F10      ___
&kp LG(LS(S)) &kp LC(Z)     &kp LC(A)     &kp C_VOL_DN   &kp C_VOL_UP   &kp M              &none            &kp F4           &kp F5           &kp F6        &kp F11      &none
              &kp LC(Y)     &kp LC(X)     &kp LC(C)      &kp LC(V)      &kp LS(F3)         &none            &kp F1           &kp F2           &kp F3        &kp F12      
                                          ___            ___            ___                ___              ___              ___              ___           ___       
            >;
        };
    };
};
